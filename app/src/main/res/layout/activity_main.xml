<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity" >
    <!-- zone dessin -->
    <FrameLayout
        android:id="@+id/drawing_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/toggle_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- sous menu formes -->
    <LinearLayout
        android:id="@+id/menu_shapes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="#DDDDDD"
        app:layout_constraintBottom_toTopOf="@id/menu_main">

        <ImageButton
            android:id="@+id/btn_line"
            android:src="@drawable/nodes"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="ligne"/>

        <ImageButton
            android:id="@+id/btn_rect"
            android:src="@drawable/rectangle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="rectangle"/>

        <ImageButton
            android:id="@+id/btn_oval"
            android:src="@drawable/circle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="ellipse"/>

    </LinearLayout>


    <!-- menu principal -->
    <LinearLayout
        android:id="@+id/menu_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="#EEEEEE"
        app:layout_constraintBottom_toTopOf="@id/toggle_button">

        <ImageButton
            android:id="@+id/icon_shape"
            android:src="@drawable/shapes"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="formes"/>

        <ImageButton
            android:id="@+id/icon_color"
            android:src="@drawable/color"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="couleurs"/>

        <ImageButton
            android:id="@+id/icon_eraser"
            android:src="@drawable/eraser"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="gomme"/>

    </LinearLayout>


    <!-- flèche -->
    <ImageButton
        android:id="@+id/toggle_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@android:drawable/arrow_up_float"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
